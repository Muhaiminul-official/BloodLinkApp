{
  "name": "bloodlink-push-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Authenticated OneSignal push delivery for BloodLink",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=../functions/.secret.local --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=../functions/.secret.local --env-file-if-exists=.env server.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.1.0",
    "firebase-admin": "^14.1.0"
  }
}
